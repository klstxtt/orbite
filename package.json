{
  "name": "orbite",
  "version": "0.1.1",
  "description": "Lanceur de jeux plein écran façon console, piloté à la manette",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "local.orbite",
    "productName": "Orbite",
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "resources/emulators",
        "to": "emulators"
      },
      {
        "from": "resources/native",
        "to": "native"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "koffi@3.3.8": true
  }
}
